{
  "title": "Andor iXon3 EMCCD - cooling & TEC",
  "uid": "andor-emccd-cooling",
  "description": "Cooling health of the Andor iXon3 EMCCD (andor_emccd_backend telemetry via Telegraf → VictoriaMetrics).",
  "tags": [
    "laserlab",
    "emccd",
    "andor"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "graphTooltip": 1,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 4,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "selected": true,
          "text": "victoria-metrics",
          "value": "dfdmpri8s8miob"
        },
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "includeAll": false,
        "multi": false
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(andor_emccd_state{db=\"laserlab\"}, host)",
          "refId": "host"
        },
        "definition": "label_values(andor_emccd_state{db=\"laserlab\"}, host)",
        "current": {},
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "sort": 1,
        "hide": 0
      },
      {
        "name": "device",
        "label": "Camera",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(andor_emccd_state{db=\"laserlab\",host=~\"$host\"}, device)",
          "refId": "device"
        },
        "definition": "label_values(andor_emccd_state{db=\"laserlab\",host=~\"$host\"}, device)",
        "current": {},
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Thermal alarm",
      "description": "Backend verdict. ALARM: cooler on, the sensor had reached the set point and is now more than cooling_lost_margin_c (5 °C) above it — typical of the heat-sink thermal switch cutting the TE cooler. WARNING: SDK reports DRIFT, or the sensor temperature cannot be read.",
      "targets": [
        {
          "refId": "A",
          "expr": "max(andor_emccd_thermal_alarm{db=\"laserlab\",host=~\"$host\",device=~\"$device\"})",
          "instant": true,
          "range": false,
          "legendFormat": "{{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "noValue": "no data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "WARNING",
                  "color": "orange",
                  "index": 1
                },
                "2": {
                  "text": "ALARM",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Sensor − set point",
      "description": "CCD sensor temperature minus the set point. The SDK calls it stabilized within ±3 °C; the backend raises ALARM above +5 °C (after the set point had been reached).",
      "targets": [
        {
          "refId": "A",
          "expr": "max(andor_emccd_sensor_temperature_c{db=\"laserlab\",host=~\"$host\",device=~\"$device\"} - andor_emccd_target_temperature_c{db=\"laserlab\",host=~\"$host\",device=~\"$device\"})",
          "instant": true,
          "range": false,
          "legendFormat": "{{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 3
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "noValue": "no data",
          "unit": "celsius",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "TEC voltage",
      "description": "SDK GetTemperatureStatus 'CoolerVolts' (8-bit, 0.03 V steps). On this camera it stays about 7.3 V while cooling (-80 and -75 °C alike) and jumped to 7.5 V for a moment when the set point was raised, so it looks like the TEC supply voltage sagging under load, not a percentage of drive. Watch for a sudden change (towards 0 V, or a steady ~7.5 V) while the cooler is ON. 'no data': the camera does not report it.",
      "targets": [
        {
          "refId": "A",
          "expr": "max(andor_emccd_cooler_voltage_v{db=\"laserlab\",host=~\"$host\",device=~\"$device\"})",
          "instant": true,
          "range": false,
          "legendFormat": "{{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "no data",
          "unit": "volt",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Camera head (TEC controller) temp.",
      "description": "Temperature at the cooler controller inside the camera head (SDK GetTemperatureStatus 'AmbientTemp'). Not the CCD sensor. Rises when the heat sink is not cooled (chiller off, low flow, fan off). Observed 2026-10-23 with water cooling: ~42 °C at -80 °C, ~39 °C at -75 °C (8-bit, 1.6 °C steps); it follows the cooler load within a minute. Colour thresholds (45/50 °C) are provisional: adjust them with more history.",
      "targets": [
        {
          "refId": "A",
          "expr": "max(andor_emccd_ambient_temperature_c{db=\"laserlab\",host=~\"$host\",device=~\"$device\"})",
          "instant": true,
          "range": false,
          "legendFormat": "{{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 45
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          },
          "noValue": "no data",
          "unit": "celsius",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
